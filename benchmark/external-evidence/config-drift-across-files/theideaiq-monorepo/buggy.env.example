# apps/web/.env.example
#
# Jules filed 4 separate PRs (#660, #690, #764, #778, #782) to fix this same drift.
# Each time Jules added keys to packages/env/src/web.ts (Zod schema) but did not
# update this file. New developers copy this file and hit a Zod crash on startup
# because SUPABASE_SERVICE_ROLE_KEY and ZAIN_SECRET_KEY are required but undocumented.
#
# MISSING: SUPABASE_SERVICE_ROLE_KEY and ZAIN_SECRET_KEY (added to schema, not here)

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# Auth
NODE_ENV=development
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# Supabase public keys (present — Jules didn't miss these)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SUPABASE_SERVICE_ROLE_KEY=  <-- MISSING: Jules added to Zod schema, forgot .env.example
# ZAIN_SECRET_KEY=            <-- MISSING: same drift, 4 separate PRs to fix
